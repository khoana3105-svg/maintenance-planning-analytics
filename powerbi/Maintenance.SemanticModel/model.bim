        "partitions": [
          {
            "name": "Dim_Date",
            "mode": "import",
            "source": {
              "expression": "let Source=Table.FromList(List.Dates(#date(2026,5,1),184,#duration(1,0,0,0)),Splitter.SplitByNothing(),{\"Date\"}), Typed=Table.TransformColumnTypes(Source,{{\"Date\",type datetime}}), Month=Table.AddColumn(Typed,\"YearMonth\",each Date.ToText(Date.From([Date]),\"yyyy-MM\"),type text), Hours=Table.AddColumn(Month,\"ScheduledHours\",each if Date.Day([Date])<=26 then 16 else 0,Int64.Type) in Hours",
              "type": "m"
            }
          }
        ]
      }
