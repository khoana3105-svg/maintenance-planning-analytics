            "sourceColumn": "Criticality",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "069beecd-8b8e-4584-a879-19abaf30a795",
        "measures": [
          {
            "name": "Total Downtime Hours",
            "expression": "COALESCE(SUM(vw_Breakdown_Analysis[Downtime_Hours]),0)",
            "formatString": "#,0.00",
            "lineageTag": "4e87269a-56ae-4f31-accc-0bab27d03854"
          },
          {
            "name": "Breakdown Count",
            "expression": "VAR n = CALCULATE(COUNTROWS(vw_Breakdown_Analysis),vw_Breakdown_Analysis[Type]=\"Corrective\") RETURN IF(ISINSCOPE(vw_Breakdown_Analysis[Failure_Mode]),n,COALESCE(n,0))",
            "formatString": "#,0",
            "lineageTag": "0e043d06-b921-4bcd-860a-d755af328bc6"
          },
          {
            "name": "Corrective Repair Hours",
            "expression": "CALCULATE(SUM(vw_Breakdown_Analysis[Duration_Hours]), vw_Breakdown_Analysis[Type] = \"Corrective\")",
            "formatString": "#,0.00",
            "lineageTag": "9346324b-05b4-4529-8bce-1940009b3d11"
          },
          {
            "name": "MTTR",
            "expression": "DIVIDE([Corrective Repair Hours], [Breakdown Count])",
            "formatString": "#,0.00",
            "lineageTag": "a3b0967a-f679-4c1c-bea8-31d615898090"
          },
          {
            "name": "Planned Production Hours",
            "expression": "SUM(Dim_Date[ScheduledHours]) * COUNTROWS(VALUES(Dim_Machine[Machine_ID]))",
            "formatString": "#,0.00",
            "lineageTag": "cbfb09ed-8288-4fa8-9690-0812bef532b9"
          },
          {
            "name": "MTBF",
            "expression": "DIVIDE([Planned Production Hours]-[Total Downtime Hours],[Breakdown Count])",
            "formatString": "#,0.00",
            "lineageTag": "0a044380-32ed-425f-a91d-95da8c3e5341"
          },
          {
            "name": "PM Tasks Due",
            "expression": "COALESCE(SUM(vw_PM_Performance[Eligible_Due]),0)",
            "formatString": "#,0",
            "lineageTag": "891fb079-2a57-4cd1-b745-2da401002aae"
          },
          {
            "name": "On Time PM",
            "expression": "COALESCE(SUM(vw_PM_Performance[On_Time]),0)",
            "formatString": "#,0",
            "lineageTag": "8975cdd6-502d-4b06-a67e-7f33844af062"
          },
          {
            "name": "PM Compliance Rate",
            "expression": "DIVIDE([On Time PM],[PM Tasks Due])",
            "formatString": "0.00%",
            "lineageTag": "cbed2302-dc9a-4c21-9e0f-d771872d25dd"
          },
          {
            "name": "Overdue PM Count",
            "expression": "COALESCE(CALCULATE(COUNTROWS(vw_PM_Performance),vw_PM_Performance[Alert_Status]=\"Overdue\"),0)",
            "formatString": "#,0",
            "lineageTag": "7da39e22-2dda-4cbc-969f-70435d9456dd"
          },
          {
            "name": "Due Soon PM Count",
            "expression": "COALESCE(CALCULATE(COUNTROWS(vw_PM_Performance),vw_PM_Performance[Alert_Status]=\"Due Soon\"),0)",
            "formatString": "#,0",
            "lineageTag": "8170c223-efd8-48c8-a65d-5a0d6fa8bb4a"
          }
        ],
        "partitions": [
